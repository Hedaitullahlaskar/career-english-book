{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "L6 unit content, generated by ChatGPT, in the D-U14 cycle (Context, Notice, Understand, Guided Practice, Role Practice, Performance Task, Feedback, Review/Retrieval)",
 "type": "object",
 "required": [
  "title",
  "cefr",
  "context",
  "notice",
  "understand",
  "guidedPractice",
  "rolePractice",
  "performanceTask",
  "feedback",
  "reviewRetrieval",
  "answerKey"
 ],
 "properties": {
  "title": {
   "type": "string",
   "minLength": 1
  },
  "cefr": {
   "enum": [
    "Pre-A1",
    "A1",
    "A2",
    "B1",
    "B2",
    "C1",
    "C2"
   ]
  },
  "context": {
   "type": "object",
   "required": [
    "setting",
    "learnerRole",
    "stakeholders",
    "objective",
    "constraints"
   ],
   "properties": {
    "setting": {
     "type": "string",
     "minLength": 1
    },
    "learnerRole": {
     "type": "string",
     "minLength": 1
    },
    "objective": {
     "type": "string",
     "minLength": 1
    },
    "constraints": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    },
    "stakeholders": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "archetype",
       "name",
       "relationship"
      ],
      "properties": {
       "archetype": {
        "type": "string",
        "minLength": 1
       },
       "name": {
        "type": "string",
        "minLength": 1
       },
       "relationship": {
        "enum": [
         "external",
         "senior",
         "peer",
         "junior"
        ]
       }
      },
      "additionalProperties": false
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "notice": {
   "type": "object",
   "required": [
    "conversation"
   ],
   "properties": {
    "conversation": {
     "type": "object",
     "required": [
      "turns"
     ],
     "properties": {
      "turns": {
       "type": "array",
       "items": {
        "type": "object",
        "required": [
         "n",
         "speaker",
         "learner",
         "text"
        ],
        "properties": {
         "n": {
          "type": "integer",
          "minimum": 1
         },
         "speaker": {
          "type": "string",
          "minLength": 1
         },
         "learner": {
          "type": "boolean"
         },
         "text": {
          "type": "string",
          "minLength": 1
         },
         "functions": {
          "type": "array",
          "items": {
           "type": "string",
           "pattern": "^CFN-\\d{4}$"
          }
         }
        },
        "additionalProperties": false
       },
       "minItems": 4
      }
     },
     "additionalProperties": false
    }
   },
   "additionalProperties": false
  },
  "understand": {
   "type": "object",
   "required": [
    "keyExpressions",
    "vocabulary"
   ],
   "properties": {
    "keyExpressions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "text",
       "function"
      ],
      "properties": {
       "text": {
        "type": "string",
        "minLength": 1
       },
       "function": {
        "type": "string",
        "pattern": "^CFN-\\d{4}$"
       },
       "note": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "minItems": 1
    },
    "vocabulary": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "term",
       "definition",
       "example"
      ],
      "properties": {
       "term": {
        "type": "string",
        "minLength": 1
       },
       "pos": {
        "type": "string"
       },
       "definition": {
        "type": "string",
        "minLength": 1
       },
       "example": {
        "type": "string",
        "minLength": 1
       },
       "existingCode": {
        "type": [
         "string",
         "null"
        ]
       },
       "tempId": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "additionalProperties": false
     }
    },
    "notes": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     }
    }
   },
   "additionalProperties": false
  },
  "jobKnowledge": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "title",
     "text"
    ],
    "properties": {
     "title": {
      "type": "string",
      "minLength": 1
     },
     "text": {
      "type": "string",
      "minLength": 1
     }
    },
    "additionalProperties": false
   }
  },
  "guidedPractice": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "type",
     "prompt",
     "items",
     "answers"
    ],
    "properties": {
     "id": {
      "type": "string",
      "minLength": 1
     },
     "type": {
      "enum": [
       "recognition",
       "gap-fill",
       "matching",
       "ordering",
       "rewriting",
       "short-answer",
       "choose-response"
      ]
     },
     "prompt": {
      "type": "string",
      "minLength": 1
     },
     "items": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "q"
       ],
       "properties": {
        "q": {
         "type": "string",
         "minLength": 1
        },
        "options": {
         "type": "array",
         "items": {
          "type": "string",
          "minLength": 1
         }
        }
       },
       "additionalProperties": false
      },
      "minItems": 1
     },
     "answers": {
      "type": "array",
      "items": {
       "type": "string",
       "minLength": 1
      },
      "minItems": 1
     }
    },
    "additionalProperties": false
   },
   "minItems": 1
  },
  "rolePractice": {
   "type": "object",
   "required": [
    "instructions",
    "cards"
   ],
   "properties": {
    "instructions": {
     "type": "string",
     "minLength": 1
    },
    "cards": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "role",
       "goal"
      ],
      "properties": {
       "role": {
        "type": "string",
        "minLength": 1
       },
       "goal": {
        "type": "string",
        "minLength": 1
       },
       "info": {
        "type": "string"
       }
      },
      "additionalProperties": false
     },
     "minItems": 2
    }
   },
   "additionalProperties": false
  },
  "performanceTask": {
   "type": "object",
   "required": [
    "prompt",
    "modes",
    "successCriteria"
   ],
   "properties": {
    "prompt": {
     "type": "string",
     "minLength": 1
    },
    "modes": {
     "type": "array",
     "items": {
      "enum": [
       "speak",
       "write"
      ]
     },
     "minItems": 1
    },
    "successCriteria": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    }
   },
   "additionalProperties": false
  },
  "feedback": {
   "type": "object",
   "required": [
    "selfCheck"
   ],
   "properties": {
    "selfCheck": {
     "type": "array",
     "items": {
      "type": "string",
      "minLength": 1
     },
     "minItems": 1
    },
    "rubric": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "criterion",
       "weight"
      ],
      "properties": {
       "criterion": {
        "type": "string",
        "minLength": 1
       },
       "weight": {
        "type": "integer",
        "minimum": 1
       }
      },
      "additionalProperties": false
     }
    }
   },
   "additionalProperties": false
  },
  "reviewRetrieval": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "prompt",
     "answer"
    ],
    "properties": {
     "prompt": {
      "type": "string",
      "minLength": 1
     },
     "answer": {
      "type": "string",
      "minLength": 1
     }
    },
    "additionalProperties": false
   },
   "minItems": 1
  },
  "answerKey": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "taskRef",
     "answer"
    ],
    "properties": {
     "taskRef": {
      "type": "string",
      "minLength": 1
     },
     "answer": {
      "type": "string",
      "minLength": 1
     }
    },
    "additionalProperties": false
   },
   "minItems": 1
  },
  "coreLinks": {
   "type": "array",
   "items": {
    "type": "string",
    "minLength": 1
   }
  }
 },
 "additionalProperties": false
}
